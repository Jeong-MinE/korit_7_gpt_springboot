<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.korit.springboot_study.mapper.BookMapper">

    <resultMap id="authorResultMap" type="com.korit.springboot_study.entity.Author">
        <id property="authorId" column="at_author_id" />
        <result property="authorName" column="author_name"/>
    </resultMap>

    <resultMap id="categoryResultMap" type="com.korit.springboot_study.entity.Category">
        <id property="categoryId" column="at_category_id" />
        <result property="categoryName" column="category_name"/>
    </resultMap>

    <resultMap id="publisherResultMap" type="com.korit.springboot_study.entity.Publisher">
        <id property="publisherId" column="publisher_id"/>
        <result property="publisherName" column="publisher_name" />
    </resultMap>

    <resultMap id="bookResultMap" type="com.korit.springboot_study.entity.Book">
        <id property="bookId" column="book_id" />
        <result property="bookName" column="book_name"/>
        <result property="authorName" column="bt_author_name"/>
        <result property="categoryName" column="bt_category_name"/>
        <result property="publisherName" column="bt_publisher_name"/>
    <association property="author" resultMap="authorResultMap" />
    <association property="category" resultMap="categoryResultMap" />
    <association property="publisher" resultMap="publisherResultMap" />
    </resultMap>


    <insert id="insert" keyProperty="bookId" useGeneratedKeys="true">
        insert into book_tb
        values (default, #{bookName}
    </insert>

    <select id = "selectBooksAll" resultMap = "bookResultMap">

        select
            bt.book_id,
            bt.book_name,
            bt.author_id as bt_author_id,
            bt.isbn,
            bt.category_id bt_category_id,
            bt.publisher_id bt_publisher_id,
            bt.book_img_url,

            at.author_id at_author_id,
            at.author_name,

            ct.category_id ct_category_id,
            ct.category_name

            pt.publisher_id pt_publisher_id,
            pt.publisher_name

        from
            book_tb bt
            left outer join author_id at on(at.author_id = bt.author_id)
            left outer join category_id ct on(ct.category_id = bt.category_id)
            left outer join publisher_id pt on(pt.publisher_id = bt.publisher_id)



    </select>


</mapper>